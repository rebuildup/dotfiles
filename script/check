#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_root="$repo_root/home"
target_root="${HOME:?HOME must be set}"
status=0

# Mirrors script/link: a top-level symlink or submodule checkout is one managed
# target, everything else is checked file by file.
unit_names=""

shopt -s nullglob dotglob
for entry in "$source_root"/*; do
  [[ -e "$entry" || -L "$entry" ]] || continue
  if [[ -L "$entry" || -e "$entry/.git" ]]; then
    unit_names+=" $(basename "$entry")"
  fi
done
shopt -u nullglob dotglob

sources() {
  local name source relative first
  for name in $unit_names; do
    printf '%s\0' "$source_root/$name"
  done
  while IFS= read -r -d '' source; do
    relative="${source#"$source_root"/}"
    first="${relative%%/*}"
    [[ " $unit_names " == *" $first "* ]] && continue
    printf '%s\0' "$source"
  done < <(find "$source_root" -type f -print0)
}

while IFS= read -r -d '' source; do
  relative="${source#"$source_root"/}"
  target="$target_root/$relative"

  if [[ ! -L "$target" ]]; then
    if [[ -e "$target" ]]; then
      printf 'drift   %s exists but is not a symlink\n' "$target" >&2
    else
      printf 'missing %s\n' "$target" >&2
    fi
    status=1
    continue
  fi

  if [[ "$(readlink "$target")" != "$source" ]]; then
    printf 'drift   %s -> %s (expected %s)\n' "$target" "$(readlink "$target")" "$source" >&2
    status=1
    continue
  fi

  printf 'ok      %s\n' "$target"
done < <(sources)

exit "$status"