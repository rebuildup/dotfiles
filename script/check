#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_root="$repo_root/home"
target_root="${HOME:?HOME must be set}"
status=0

# Mirrors script/link: a top-level symlink or submodule checkout is one managed
# target, everything else is checked file by file.
unit_names=()

shopt -s nullglob dotglob
for entry in "$source_root"/*; do
  [[ -e "$entry" || -L "$entry" ]] || continue
  if [[ -L "$entry" || -e "$entry/.git" ]]; then
    unit_names+=("$(basename "$entry")")
  fi
done
shopt -u nullglob dotglob

# Exact-name membership, matching script/link. Names may contain spaces.
is_unit_name() {
  local candidate="$1" name
  [[ ${#unit_names[@]} -gt 0 ]] || return 1
  for name in "${unit_names[@]}"; do
    [[ "$name" == "$candidate" ]] && return 0
  done
  return 1
}

sources() {
  local name source relative first
  if [[ ${#unit_names[@]} -gt 0 ]]; then
    for name in "${unit_names[@]}"; do
      printf '%s\0' "$source_root/$name"
    done
  fi
  while IFS= read -r -d '' source; do
    relative="${source#"$source_root"/}"
    first="${relative%%/*}"
    is_unit_name "$first" && continue
    is_composer_owned "$relative" && continue
    printf '%s\0' "$source"
  done < <(find "$source_root" \( -type f -o -type l \) -print0)
}

# Claude settings are generated by script/claude-settings.ts, not symlinked.
# Skip the canonical file the composer owns and any backup the composer may
# have left in the working tree (home/.claude/*.bak from migrations, or the
# older pre-dotfiles-* pattern). Leaving these under HOME is harmless: the
# composer writes its backups under the state directory, never next to the
# live file, and these leftovers must never be promoted to a managed target.
is_composer_owned() {
  local relative="$1"
  case "$relative" in
    .claude/settings.json) return 0 ;;
    .claude/*.bak) return 0 ;;
    .claude/*.pre-dotfiles-*) return 0 ;;
  esac
  return 1
}

while IFS= read -r -d '' source; do
  relative="${source#"$source_root"/}"
  target="$target_root/$relative"

  if [[ ! -L "$target" ]]; then
    if [[ -e "$target" ]]; then
      printf 'drift   %s exists but is not a symlink\n' "$target" >&2
    else
      printf 'missing %s\n' "$target" >&2
    fi
    status=1
    continue
  fi

  if [[ "$(readlink "$target")" != "$source" ]]; then
    printf 'drift   %s -> %s (expected %s)\n' "$target" "$(readlink "$target")" "$source" >&2
    status=1
    continue
  fi

  printf 'ok      %s\n' "$target"
done < <(sources)

# Claude settings are generated, so verify the live file matches the composition.
if command -v bun >/dev/null 2>&1; then
  bun "$repo_root/script/claude-settings.ts" check || status=1
fi

exit "$status"
