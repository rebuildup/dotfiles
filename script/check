#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source_root="$repo_root/home"
target_root="${HOME:?HOME must be set}"
status=0

# The managed target set (whole-directory units, composer-owned exclusions,
# per-file sources) is defined once in script/lib/managed-targets.sh and
# shared with script/link so both always agree on what is managed.
# shellcheck source=script/lib/managed-targets.sh
source "$repo_root/script/lib/managed-targets.sh"

sources() {
  managed_sources "$source_root"
}

while IFS= read -r -d '' source; do
  relative="${source#"$source_root"/}"
  target="$target_root/$relative"

  if [[ ! -L "$target" ]]; then
    if [[ -e "$target" ]]; then
      printf 'drift   %s exists but is not a symlink\n' "$target" >&2
    else
      printf 'missing %s\n' "$target" >&2
    fi
    status=1
    continue
  fi

  if [[ "$(readlink "$target")" != "$source" ]]; then
    printf 'drift   %s -> %s (expected %s)\n' "$target" "$(readlink "$target")" "$source" >&2
    status=1
    continue
  fi

  printf 'ok      %s\n' "$target"
done < <(sources)

# Claude settings are generated, so verify the live file matches the composition.
if command -v bun >/dev/null 2>&1; then
  bun "$repo_root/script/claude-settings.ts" check || status=1
fi

exit "$status"
