#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
secret_file="${DOTFILES_SECRET_FILE:-$repo_root/secrets/global.sops.json}"

if [[ "$#" -ne 1 ]]; then
  printf "usage: %s 'command string'\n" "$0" >&2
  printf 'set DOTFILES_SECRET_FILE to select another encrypted environment file\n' >&2
  exit 2
fi

if ! command -v sops >/dev/null 2>&1; then
  printf 'missing required command: sops (install it via pc-setup)\n' >&2
  exit 1
fi

if [[ ! -f "$secret_file" ]]; then
  printf 'missing encrypted secret file: %s\n' "$secret_file" >&2
  exit 1
fi

exec sops exec-env --same-process "$secret_file" "$1"
