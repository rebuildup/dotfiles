#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=config/infisical.sh
source "$repo_root/config/infisical.sh"

# Shared strict binding validation (parsed JSON, project + environment),
# also used by script/secrets-doctor and mirrored by script/with-secrets.ps1.
# shellcheck source=script/lib/infisical-binding.sh
source "$repo_root/script/lib/infisical-binding.sh"

if [[ "$#" -lt 1 ]]; then
  printf 'usage: %s command [args...]\n' "$0" >&2
  exit 2
fi

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing required command: infisical (install it via pc-setup)\n' >&2
  exit 1
fi

if [[ ! -f "$repo_root/.infisical.json" ]]; then
  printf 'missing tracked Infisical project binding: %s/.infisical.json\n' "$repo_root" >&2
  exit 1
fi

infisical_binding_check "$repo_root/.infisical.json" || exit 1

exec infisical run "--projectId=$INFISICAL_PROJECT_ID" "--env=$INFISICAL_ENVIRONMENT" "--project-config-dir=$repo_root" -- "$@"
