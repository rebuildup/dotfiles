#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

if [[ "$#" -lt 1 ]]; then
  printf 'usage: %s command [args...]\n' "$0" >&2
  exit 2
fi

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing required command: infisical (install it via pc-setup)\n' >&2
  exit 1
fi

if [[ ! -f "$repo_root/.infisical.json" ]]; then
  printf 'missing Infisical project binding: %s/.infisical.json\n' "$repo_root" >&2
  printf 'run ./script/bootstrap or infisical init first\n' >&2
  exit 1
fi

exec infisical run "--project-config-dir=$repo_root" -- "$@"
