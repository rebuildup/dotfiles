#!/usr/bin/env python3
"""Mock tests for script/agent-launcher.

No network, no real secrets: the harness binaries are replaced by stubs
that dump their argv and environment, and script/with-secrets is replaced
by a stub that injects a fake Infisical `dev` secret set.

Run: ./script/test-agent
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
LAUNCHER = REPO / "script" / "agent-launcher"
REAL_CONFIG = REPO / "config" / "agents.toml"

with open(REAL_CONFIG, "rb") as _handle:
    # shortcut names derived from the routes, exactly like the launcher does
    REAL_SHORTCUTS = tuple(
        sorted(
            f"{key.split('.', 1)[0]}-{key.split('.', 1)[1]}"
            for key in tomllib.load(_handle)["routes"]
        )
    )

HARNESSES = ("claude", "opencode", "pi", "dsh")

FAKE_HARNESS = """#!/usr/bin/env bash
set -euo pipefail
{
  printf 'ARGV\\n'
  for arg in "$@"; do printf '%s\\n' "$arg"; done
  printf 'ARGV-END\\n'
  env | sort
} > "${AGENT_TEST_OUT:?}"
"""

# Simulates `infisical run --env dev`: injects every secret of the project.
FAKE_WITH_SECRETS = """#!/usr/bin/env bash
set -euo pipefail
if [[ -n "${AGENT_TEST_MARKER:-}" ]]; then
  : > "$AGENT_TEST_MARKER"
fi
if [[ -n "${AGENT_TEST_WRAPPER_ARGV:-}" ]]; then
  printf '%s\\n' "$@" > "$AGENT_TEST_WRAPPER_ARGV"
fi
export FAKE_INFISICAL_INJECTED=yes
export DEEPSEEK_API_KEY=secret-deepseek
export OPENROUTER_API_KEY=secret-openrouter
export OPENCODE_API_KEY=secret-zen
export MINIMAX_M_PLAN_KEY=secret-minimax-plan
export MINIMAX_TOKEN_PLAN_KEY=secret-minimax-legacy
export MIMO_API_KEY=secret-mimo
export ANTHROPIC_AUTH_TOKEN=secret-anthropic
export INFISICAL_TOKEN=secret-infisical
exec "$@"
"""

# Same, but the DeepSeek secret is absent (rotated/never provisioned).
FAKE_WITH_SECRETS_NO_DEEPSEEK = FAKE_WITH_SECRETS.replace(
    "export DEEPSEEK_API_KEY=secret-deepseek\n", ""
)

PRECEDENCE_CONFIG = """
[defaults]
drop_env = ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"]

[providers.p1]
label = "P1"
base_url = "https://p1.example/api"
secret = "DEEPSEEK_API_KEY"
env = "DEEPSEEK_API_KEY"
default_model = "provider-model"
models = ["provider-model", "route-model", "cli-model"]

[providers.p2]
label = "P2"
secret = "CUSTOMP_API_KEY"
env = "CUSTOMP_API_KEY"
default_model = "provider-model"
models = ["provider-model"]

[harnesses.h1]
label = "H1"
command = "claude"
adapter = "anthropic"

[harnesses.h1.env]
base_url = "ANTHROPIC_BASE_URL"
auth_token = "ANTHROPIC_AUTH_TOKEN"
api_key = "ANTHROPIC_API_KEY"
model = "ANTHROPIC_MODEL"
small_fast_model = "ANTHROPIC_SMALL_FAST_MODEL"
default_opus = "ANTHROPIC_DEFAULT_OPUS_MODEL"
default_sonnet = "ANTHROPIC_DEFAULT_SONNET_MODEL"
default_haiku = "ANTHROPIC_DEFAULT_HAIKU_MODEL"

[routes."h1.p1"]
default_model = "route-model"
"""

GHOST_CONFIG = """
[providers.p1]
label = "P1"
secret = "DEEPSEEK_API_KEY"
env = "DEEPSEEK_API_KEY"
default_model = "provider-model"
models = ["provider-model"]

[harnesses.ghost]
label = "Ghost"
command = "definitely-not-installed-harness"
adapter = "passthrough"

[routes."ghost.p1"]
"""


class Fixture:
    def __init__(self) -> None:
        self.tmp = Path(tempfile.mkdtemp(prefix="agent-launcher-test-"))
        self.bindir = self.tmp / "bin"
        self.bindir.mkdir()
        self.out = self.tmp / "child.env"
        self.marker = self.tmp / "wrapper.ran"
        self.wrapper_argv = self.tmp / "wrapper.argv"
        self.wrapper = self.tmp / "with-secrets"
        self.write_wrapper(FAKE_WITH_SECRETS)
        for harness in HARNESSES:
            path = self.bindir / harness
            path.write_text(FAKE_HARNESS)
            path.chmod(0o755)

    def write_wrapper(self, content: str) -> None:
        self.wrapper.write_text(content)
        self.wrapper.chmod(0o755)

    def base_env(self, extra: dict | None = None) -> dict:
        env = {
            "PATH": f"{self.bindir}:{os.environ.get('PATH', '/usr/bin:/bin')}",
            "HOME": os.environ.get("HOME", str(self.tmp)),
            "AGENT_WITH_SECRETS": str(self.wrapper),
            "AGENT_TEST_OUT": str(self.out),
            "AGENT_TEST_MARKER": str(self.marker),
            "AGENT_TEST_WRAPPER_ARGV": str(self.wrapper_argv),
        }
        if extra:
            env.update(extra)
        return env

    def run(self, args: list[str], env_extra: dict | None = None,
            config: Path | None = None) -> subprocess.CompletedProcess:
        if self.out.exists():
            self.out.unlink()
        if self.marker.exists():
            self.marker.unlink()
        if self.wrapper_argv.exists():
            self.wrapper_argv.unlink()
        env = self.base_env(env_extra)
        if config is not None:
            env["AGENT_CONFIG"] = str(config)
        return subprocess.run(
            [str(LAUNCHER)] + args,
            env=env,
            capture_output=True,
            text=True,
        )

    def run_shortcut(self, name: str, args: list[str],
                     env_extra: dict | None = None,
                     config: Path | None = None) -> subprocess.CompletedProcess:
        """Invoke the launcher through a `<harness>-<provider>` symlink."""
        link = self.bindir / name
        if not link.exists() and not link.is_symlink():
            link.symlink_to(LAUNCHER)
        if self.out.exists():
            self.out.unlink()
        if self.marker.exists():
            self.marker.unlink()
        if self.wrapper_argv.exists():
            self.wrapper_argv.unlink()
        env = self.base_env(env_extra)
        if config is not None:
            env["AGENT_CONFIG"] = str(config)
        return subprocess.run(
            [str(link)] + args,
            env=env,
            capture_output=True,
            text=True,
        )

    def child(self) -> tuple[list[str], dict[str, str]]:
        """Parse the stub harness dump: (argv, env)."""
        if not self.out.exists():
            raise AssertionError("child harness never ran")
        lines = self.out.read_text().splitlines()
        if not lines or lines[0] != "ARGV":
            raise AssertionError(f"unexpected dump header: {lines[:1]}")
        try:
            end = lines.index("ARGV-END")
        except ValueError as error:
            raise AssertionError("dump misses ARGV-END") from error
        argv = lines[1:end]
        env = {}
        for line in lines[end + 1:]:
            name, _, value = line.partition("=")
            env[name] = value
        return argv, env

    def clean(self) -> None:
        shutil.rmtree(self.tmp, ignore_errors=True)


def check(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def test_config_valid(fixture: Fixture) -> None:
    result = fixture.run(["check"], config=REAL_CONFIG)
    check(result.returncode == 0, f"check failed: {result.stderr}")
    check("config OK" in result.stdout, result.stdout)
    check(f"{REAL_CONFIG}" in result.stdout or "config OK" in result.stdout,
          result.stdout)


def test_help(fixture: Fixture) -> None:
    for args in (["help"], ["--help"], ["-h"], ["claude", "openrouter", "--help"]):
        result = fixture.run(args, config=REAL_CONFIG)
        check(result.returncode == 0, f"{args} -> {result.returncode}: {result.stderr}")
        check("usage:" in result.stdout, f"{args}: no usage in stdout")
    result = fixture.run([], config=REAL_CONFIG)
    check(result.returncode == 2, "bare `agent` must exit 2")
    check("usage:" in result.stderr, "bare `agent` must print usage on stderr")


def test_list(fixture: Fixture) -> None:
    result = fixture.run(["list"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    for route in ("claude.openrouter", "claude.deepseek", "claude.minimax",
                  "opencode.zen", "pi.deepseek", "dsh.deepseek"):
        check(route in result.stdout, f"list misses {route}: {result.stdout}")
    check("--model required" not in result.stdout,
          "every configured route must resolve a default model")
    check("MiniMax-M2.5" in result.stdout, "minimax default missing")
    check("mimo-v2.6-flash-free" in result.stdout, "zen default missing")
    check("opencode-zen" in result.stdout, "shortcut names must be listed")


def test_models(fixture: Fixture) -> None:
    result = fixture.run(["models", "deepseek"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    check("DEEPSEEK_API_KEY" in result.stdout, result.stdout)
    check("deepseek-flash" in result.stdout, result.stdout)
    check("https://api.deepseek.com/anthropic" in result.stdout, result.stdout)
    check("routes:" in result.stdout, result.stdout)

    result = fixture.run(["models", "zen"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    check("opencode/mimo-v2.6-flash-free" in result.stdout, result.stdout)

    result = fixture.run(["models", "nope"], config=REAL_CONFIG)
    check(result.returncode == 2, "unknown provider must exit 2")
    check("unknown provider" in result.stderr, result.stderr)


def test_unknown_selection(fixture: Fixture) -> None:
    cases = [
        (["bogus", "zen"], "unknown harness"),
        (["claude", "bogus"], "unknown provider"),
        (["dsh", "openrouter"], "available providers for 'dsh'"),
        (["claude"], "missing provider"),
        (["claude", "openrouter", "stray"], "unexpected argument"),
        (["claude", "openrouter", "--model"], "requires a value"),
    ]
    for args, needle in cases:
        result = fixture.run(args, config=REAL_CONFIG)
        check(result.returncode == 2, f"{args} -> {result.returncode}: {result.stderr}")
        check(needle in result.stderr, f"{args}: expected {needle!r} in {result.stderr!r}")


def test_unknown_model(fixture: Fixture) -> None:
    result = fixture.run(
        ["claude", "openrouter", "--model", "gpt-expensive"], config=REAL_CONFIG
    )
    check(result.returncode == 2, result.stderr)
    check("unknown model" in result.stdout + result.stderr, result.stderr)
    # route-level model list overrides the provider list (claude.deepseek)
    result = fixture.run(
        ["claude", "deepseek", "--model", "deepseek-v4-pro"], config=REAL_CONFIG
    )
    check(result.returncode == 2, "route model list must be enforced")
    check("unknown model" in result.stderr, result.stderr)


def test_minimax_default_model(fixture: Fixture) -> None:
    # no --model: the verified default applies (fail closed is kept by the
    # models list — unknown ids are rejected before a process starts)
    result = fixture.run(["claude", "minimax"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == [], f"argv {argv}")
    check(env.get("ANTHROPIC_BASE_URL") == "https://api.minimax.io/anthropic", env)
    check(env.get("ANTHROPIC_MODEL") == "MiniMax-M2.5", env)
    check(env.get("ANTHROPIC_DEFAULT_OPUS_MODEL") == "MiniMax-M2.5", env)
    check(env.get("ANTHROPIC_DEFAULT_HAIKU_MODEL") == "MiniMax-M2.5", env)
    check(env.get("ANTHROPIC_SMALL_FAST_MODEL") == "MiniMax-M2.5", env)
    # secret rename: Infisical MINIMAX_M_PLAN_KEY -> harness MINIMAX_API_KEY
    check(env.get("MINIMAX_API_KEY") == "secret-minimax-plan", env.get("MINIMAX_API_KEY"))
    check(env.get("ANTHROPIC_AUTH_TOKEN") == "secret-minimax-plan",
          f"auth token was {env.get('ANTHROPIC_AUTH_TOKEN')!r}")
    # ... but no other provider's secret reaches the child
    for leak in ("DEEPSEEK_API_KEY", "OPENROUTER_API_KEY", "OPENCODE_API_KEY",
                 "MIMO_API_KEY", "INFISICAL_TOKEN",
                 "FAKE_INFISICAL_INJECTED", "MINIMAX_TOKEN_PLAN_KEY"):
        check(leak not in env, f"secret leaked to child: {leak}")
    check(fixture.marker.exists(), "with-secrets wrapper was not used")

    # --model still overrides the default for one process
    result = fixture.run(
        ["claude", "minimax", "--model", "MiniMax-M3"], config=REAL_CONFIG
    )
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "MiniMax-M3", env)

    # ids outside the model list still fail closed
    result = fixture.run(
        ["claude", "minimax", "--model", "MiniMax-not-a-model"], config=REAL_CONFIG
    )
    check(result.returncode == 2, "unknown minimax model must exit 2")
    check("unknown model" in result.stderr, result.stderr)


REQUIRE_CONFIG = """
[providers.p1]
label = "P1"
base_url = "https://p1.example/api"
secret = "DEEPSEEK_API_KEY"
env = "DEEPSEEK_API_KEY"
require_model = true
models = ["m1", "m2"]

[harnesses.h1]
label = "H1"
command = "claude"
adapter = "anthropic"
[harnesses.h1.env]
base_url = "ANTHROPIC_BASE_URL"
auth_token = "ANTHROPIC_AUTH_TOKEN"
api_key = "ANTHROPIC_API_KEY"
model = "ANTHROPIC_MODEL"
small_fast_model = "ANTHROPIC_SMALL_FAST_MODEL"
default_opus = "ANTHROPIC_DEFAULT_OPUS_MODEL"
default_sonnet = "ANTHROPIC_DEFAULT_SONNET_MODEL"
default_haiku = "ANTHROPIC_DEFAULT_HAIKU_MODEL"

[routes."h1.p1"]
"""


def test_require_model_fail_closed(fixture: Fixture) -> None:
    config = fixture.tmp / "require.toml"
    config.write_text(REQUIRE_CONFIG)
    result = fixture.run(["h1", "p1"], config=config)
    check(result.returncode == 2,
          f"expected 2, got {result.returncode}: {result.stderr}")
    check("requires an explicit model" in result.stderr, result.stderr)
    check(not fixture.marker.exists(), "credentials must not be fetched first")

    result = fixture.run(["h1", "p1", "--model", "m2"], config=config)
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "m2", env)


def test_shortcut_equivalence(fixture: Fixture) -> None:
    """`opencode-zen` must start exactly what `agent opencode zen` starts."""
    result = fixture.run(["opencode", "zen"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    ref_argv, ref_env = fixture.child()

    result = fixture.run_shortcut("opencode-zen", [], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ref_argv, f"argv {argv} != {ref_argv}")
    check(env == ref_env, "shortcut child env must equal the agent-form env")
    check(
        env.get("OPENCODE_CONFIG_CONTENT", "").endswith(
            '"opencode/mimo-v2.6-flash-free"}'
        ),
        f"model selection differs: {env.get('OPENCODE_CONFIG_CONTENT')}",
    )


def test_shortcut_args_and_agent_model(fixture: Fixture) -> None:
    result = fixture.run_shortcut("claude-deepseek", ["-p", "hi"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["-p", "hi"], f"argv {argv}")
    check(env.get("ANTHROPIC_MODEL") == "deepseek-flash", env)

    for model_args in (
        ["--agent-model", "deepseek-v4-pro", "-p", "hi"],
        ["--agent-model=deepseek-v4-pro", "-p", "hi"],
    ):
        result = fixture.run_shortcut(
            "opencode-deepseek", model_args, config=REAL_CONFIG
        )
        check(result.returncode == 0, result.stderr)
        argv, env = fixture.child()
        check(argv == ["--standalone", "-p", "hi"],
              f"launcher flag leaked into argv: {argv}")
        check("deepseek/deepseek-v4-pro" in env.get("OPENCODE_CONFIG_CONTENT", ""),
              env.get("OPENCODE_CONFIG_CONTENT"))

    result = fixture.run_shortcut("claude-deepseek", ["--agent-model"],
                                  config=REAL_CONFIG)
    check(result.returncode == 2, "missing value must fail")
    check("requires a value" in result.stderr, result.stderr)

    # a leading '--' is tolerated (habit from the agent form)
    result = fixture.run_shortcut("claude-deepseek", ["--", "-p", "hi"],
                                  config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, _ = fixture.child()
    check(argv == ["-p", "hi"], f"argv {argv}")


def test_shortcut_forbidden_args(fixture: Fixture) -> None:
    cases = [
        ["--model", "deepseek-v4-pro"],
        ["-m", "deepseek-v4-pro"],
        ["--provider", "openrouter"],
        ["--api-key=sk-x"],
        ["--fallback-model=x"],
    ]
    for args in cases:
        result = fixture.run_shortcut("opencode-zen", args, config=REAL_CONFIG)
        check(result.returncode == 2,
              f"{args} -> {result.returncode}: {result.stderr}")
        check("not allowed" in result.stderr, f"{args}: {result.stderr}")
    check(not fixture.marker.exists(), "credentials must not be fetched")

    # passthrough harnesses keep rejecting launcher-owned model selection
    result = fixture.run_shortcut("dsh-deepseek", ["--agent-model", "x"],
                                  config=REAL_CONFIG)
    check(result.returncode == 2, result.stderr)
    check("does not accept" in result.stderr, result.stderr)


def test_shortcut_unknown_name(fixture: Fixture) -> None:
    result = fixture.run_shortcut("claude-zen", [], config=REAL_CONFIG)
    check(result.returncode == 2, f"{result.returncode}: {result.stderr}")
    check("unknown shortcut" in result.stderr, result.stderr)
    check("opencode-zen" in result.stderr, "known shortcuts must be listed")
    check(not fixture.marker.exists(), "credentials must not be fetched")

    result = fixture.run_shortcut("totally-bogus", [], config=REAL_CONFIG)
    check(result.returncode == 2, result.stderr)

    # subcommand names are not shortcuts
    result = fixture.run_shortcut("list", [], config=REAL_CONFIG)
    check(result.returncode == 2, "agent subcommands must not be shortcuts")


def test_shortcuts_link_management(fixture: Fixture) -> None:
    links = fixture.tmp / "links"
    env = {"AGENT_BIN_DIR": str(links)}

    result = fixture.run(["shortcuts"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    for name in REAL_SHORTCUTS:
        check(name in result.stdout, f"shortcuts list misses {name}")
    check("claude-zen" not in result.stdout, "non-route must not be listed")
    check("missing" in result.stdout, result.stdout)

    result = fixture.run(["shortcuts", "check"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 1, "check must fail before create")

    # a native harness entry in the same directory is never touched
    links.mkdir()
    native = links / "claude"
    native.symlink_to("/bin/ls")

    result = fixture.run(["shortcuts", "create"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    check(native.is_symlink() and native.resolve() == Path("/bin/ls").resolve(),
          "native claude entry must be untouched")
    for name in REAL_SHORTCUTS:
        path = links / name
        check(path.is_symlink(), f"{name} was not created")
        check(path.resolve() == LAUNCHER.resolve(), f"{name} points elsewhere")
    check(not (links / "claude-zen").exists(),
          "non-route shortcut must not be created")

    # re-running is safe (idempotent)
    result = fixture.run(["shortcuts", "create"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    check("0 created" in result.stdout, result.stdout)
    result = fixture.run(["shortcuts", "check"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)

    # an unmanaged file is never overwritten
    victim = links / "pi-openrouter"
    victim.unlink()
    victim.write_text("not ours\n")
    result = fixture.run(["shortcuts", "create"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 1, result.stderr)
    check("refusing to overwrite" in result.stderr, result.stderr)
    check(victim.read_text() == "not ours\n", "conflicting file must be untouched")
    result = fixture.run(["shortcuts", "check"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 1, "check must fail on a conflict")

    # remove takes back only what the launcher owns
    victim.unlink()
    foreign = links / "opencode-deepseek"
    foreign.unlink()
    foreign.symlink_to("/bin/ls")
    result = fixture.run(["shortcuts", "remove"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    check(foreign.is_symlink() and foreign.resolve() == Path("/bin/ls").resolve(),
          "foreign symlink must survive remove")
    check(native.is_symlink(), "native entry must survive remove")
    for name in REAL_SHORTCUTS:
        if name == "opencode-deepseek":
            continue
        check(not (links / name).exists(), f"{name} must be removed")
    result = fixture.run(["shortcuts", "check"], env_extra=env, config=REAL_CONFIG)
    check(result.returncode == 1, "check must fail after remove")

    result = fixture.run(["shortcuts", "frobnicate"], env_extra=env,
                         config=REAL_CONFIG)
    check(result.returncode == 2, result.stderr)


def test_native_harness_not_wrapped(fixture: Fixture) -> None:
    """Plain `claude`/`opencode` never go through the launcher."""
    env = fixture.base_env()
    result = subprocess.run(
        [str(fixture.bindir / "claude"), "--version"],
        env=env, capture_output=True, text=True,
    )
    check(result.returncode == 0, result.stderr)
    _, child_env = fixture.child()
    check(child_env.get("ANTHROPIC_MODEL") is None,
          "native claude must not receive route env")
    check(child_env.get("ANTHROPIC_BASE_URL") is None,
          "native claude must not be redirected")
    check(not fixture.marker.exists(),
          "with-secrets must not run for a native command")


def test_claude_deepseek_filters_preset_secrets(fixture: Fixture) -> None:
    result = fixture.run(
        ["claude", "deepseek"],
        env_extra={"OPENROUTER_API_KEY": "preset-openrouter"},
        config=REAL_CONFIG,
    )
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == [], argv)
    check(env.get("ANTHROPIC_BASE_URL") == "https://api.deepseek.com/anthropic", env)
    check(env.get("ANTHROPIC_MODEL") == "deepseek-flash", env)
    check(env.get("ANTHROPIC_AUTH_TOKEN") == "secret-deepseek",
          f"auth token was {env.get('ANTHROPIC_AUTH_TOKEN')!r}")
    check("ANTHROPIC_API_KEY" not in env, "ANTHROPIC_API_KEY must be cleared")
    check(env.get("DEEPSEEK_API_KEY") == "secret-deepseek", env)
    check("OPENROUTER_API_KEY" not in env,
          "pre-existing other-provider secret must be dropped")
    check("OPENCODE_API_KEY" not in env, "injected zen secret must be dropped")
    check(fixture.marker.exists(), "with-secrets wrapper was not used")


def test_env_short_circuits_injection(fixture: Fixture) -> None:
    result = fixture.run(
        ["claude", "deepseek"],
        env_extra={"DEEPSEEK_API_KEY": "already-here"},
        config=REAL_CONFIG,
    )
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_AUTH_TOKEN") == "already-here", env)
    check(not fixture.marker.exists(),
          "with-secrets must be skipped when the credential is already set")


def test_missing_secret_fails(fixture: Fixture) -> None:
    fixture.write_wrapper(FAKE_WITH_SECRETS_NO_DEEPSEEK)
    result = fixture.run(["claude", "deepseek"], config=REAL_CONFIG)
    check(result.returncode == 1, f"expected exit 1, got {result.returncode}")
    check("DEEPSEEK_API_KEY" in result.stderr, result.stderr)
    check("Infisical" in result.stderr, result.stderr)
    check(not fixture.out.exists(), "harness must not start without credentials")


def test_opencode_zen(fixture: Fixture) -> None:
    result = fixture.run(
        ["opencode", "zen"],
        env_extra={"OPENCODE_CONFIG_CONTENT": '{"permission":"allow"}'},
        config=REAL_CONFIG,
    )
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["--standalone"], argv)
    check(env.get("OPENCODE_API_KEY") == "secret-zen", env)
    content = json.loads(env["OPENCODE_CONFIG_CONTENT"])
    check(content["model"] == "opencode/mimo-v2.6-flash-free", content)
    check(content.get("permission") == "allow", "existing inline config must merge")
    # the wrapper stage must never see the caller's inline config (it may
    # contain provider apiKey values): only the model id crosses argv
    check(fixture.marker.exists(), "with-secrets wrapper was not used")
    wrapper_text = fixture.wrapper_argv.read_text() if fixture.wrapper_argv.exists() else ""
    check('"permission"' not in wrapper_text,
          f"caller inline config leaked into wrapper argv: {wrapper_text[:200]}")

    result = fixture.run(
        ["opencode", "zen", "--", "run", "hello world"], config=REAL_CONFIG
    )
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["run", "--standalone", "hello world"], argv)
    check(json.loads(env["OPENCODE_CONFIG_CONTENT"])["model"]
          == "opencode/mimo-v2.6-flash-free", env)

    # TUI flags keep the root position, session subcommands are untouched,
    # and an explicit --standalone/--server is never duplicated.
    for passthru, expected in (
        (["--continue"], ["--standalone", "--continue"]),
        (["models"], ["models"]),
        (["--standalone", "run", "x"], ["--standalone", "run", "x"]),
    ):
        result = fixture.run(["opencode", "zen", "--"] + passthru, config=REAL_CONFIG)
        check(result.returncode == 0, f"{passthru}: {result.stderr}")
        argv, _ = fixture.child()
        check(argv == expected, f"{passthru} -> {argv}")

    # explicit --model wins over the provider default
    result = fixture.run(
        ["opencode", "zen", "--model", "big-pickle"], config=REAL_CONFIG
    )
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(json.loads(env["OPENCODE_CONFIG_CONTENT"])["model"] == "opencode/big-pickle",
          env)


def test_opencode_deepseek(fixture: Fixture) -> None:
    result = fixture.run(["opencode", "deepseek"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["--standalone"], argv)
    check(env.get("DEEPSEEK_API_KEY") == "secret-deepseek", env)
    check(json.loads(env["OPENCODE_CONFIG_CONTENT"])["model"] == "deepseek/deepseek-flash",
          env)
    check("OPENROUTER_API_KEY" not in env and "OPENCODE_API_KEY" not in env,
          "other secrets must not leak")


def test_pi_deepseek(fixture: Fixture) -> None:
    result = fixture.run(["pi", "deepseek", "--", "-p", "hi"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["--provider", "deepseek", "--model", "deepseek-flash", "-p", "hi"],
          argv)
    check(env.get("DEEPSEEK_API_KEY") == "secret-deepseek", env)
    check("OPENROUTER_API_KEY" not in env, "leak")

    result = fixture.run(
        ["pi", "deepseek", "--model", "deepseek-v4-pro", "--", "-p", "hi"],
        config=REAL_CONFIG,
    )
    check(result.returncode == 0, result.stderr)
    argv, _ = fixture.child()
    check("--model" in argv and "deepseek-v4-pro" in argv, argv)


def test_dsh_passthrough(fixture: Fixture) -> None:
    result = fixture.run(["dsh", "deepseek", "--", "web"], config=REAL_CONFIG)
    check(result.returncode == 0, result.stderr)
    argv, env = fixture.child()
    check(argv == ["web"], argv)
    check(env.get("DEEPSEEK_API_KEY") == "secret-deepseek", env)

    result = fixture.run(["dsh", "deepseek", "--model", "x"], config=REAL_CONFIG)
    check(result.returncode == 2, "dsh must reject --model")
    check("does not accept --model" in result.stderr, result.stderr)


def test_forbidden_passthru_flags(fixture: Fixture) -> None:
    cases = [
        (["pi", "openrouter", "--", "--model", "x"], "--model"),
        (["claude", "deepseek", "--", "--model=deepseek-v4-pro"], "--model"),
        (["claude", "openrouter", "--", "--fallback-model", "x"], "--fallback-model"),
        (["claude", "openrouter", "--", "--fallback-model=x"], "--fallback-model"),
        (["pi", "openrouter", "--", "--api-key", "x"], "--api-key"),
        (["pi", "deepseek", "--", "--provider", "openrouter"], "--provider"),
    ]
    for args, needle in cases:
        result = fixture.run(args, config=REAL_CONFIG)
        check(result.returncode == 2, f"{args} -> {result.returncode}")
        check(needle in result.stderr, f"{args}: {result.stderr}")


def test_model_precedence(fixture: Fixture) -> None:
    config = fixture.tmp / "precedence.toml"
    config.write_text(PRECEDENCE_CONFIG)

    result = fixture.run(["h1", "p1"], config=config)
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "route-model",
          f"route default must win: {env.get('ANTHROPIC_MODEL')}")

    result = fixture.run(["h1", "p1", "--model", "cli-model"], config=config)
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "cli-model", "CLI --model must win")
    check(env.get("ANTHROPIC_DEFAULT_SONNET_MODEL") == "cli-model", env)

    result = fixture.run(["h1", "p1", "-m", "cli-model"], config=config)
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "cli-model", "-m must work")


def test_fast_path_drops_declared_provider_creds(fixture: Fixture) -> None:
    """All secrets preset: no wrapper, but other providers' creds still drop."""
    config = fixture.tmp / "precedence.toml"
    config.write_text(PRECEDENCE_CONFIG)
    result = fixture.run(
        ["h1", "p1"],
        env_extra={
            "DEEPSEEK_API_KEY": "preset-p1",
            "CUSTOMP_API_KEY": "preset-p2",
        },
        config=config,
    )
    check(result.returncode == 0, result.stderr)
    _, env = fixture.child()
    check(env.get("DEEPSEEK_API_KEY") == "preset-p1",
          "selected provider secret must survive")
    check("CUSTOMP_API_KEY" not in env,
          "declared provider secret must be dropped on the fast path")
    check(not fixture.marker.exists(),
          "fast path must not invoke with-secrets")


def test_agent_model_env_warns(fixture: Fixture) -> None:
    result = fixture.run(
        ["claude", "openrouter"],
        env_extra={"AGENT_MODEL": "legacy-model"},
        config=REAL_CONFIG,
    )
    check(result.returncode == 0, result.stderr)
    check("AGENT_MODEL is no longer read" in result.stderr, result.stderr)
    _, env = fixture.child()
    check(env.get("ANTHROPIC_MODEL") == "z-ai/glm-5.3-flash",
          f"legacy env must not select the model: {env.get('ANTHROPIC_MODEL')}")


def test_missing_harness(fixture: Fixture) -> None:
    config = fixture.tmp / "ghost.toml"
    config.write_text(GHOST_CONFIG)
    result = fixture.run(["ghost", "p1"], config=config)
    check(result.returncode == 1, f"expected 1, got {result.returncode}: {result.stderr}")
    check("harness not found" in result.stderr, result.stderr)
    check(not fixture.marker.exists(), "credentials must not be fetched first")


def test_invalid_configs(fixture: Fixture) -> None:
    cases = [
        # provider without default and route without require_model
        (
            """
[providers.p1]
label = "P"
models = ["m"]

[harnesses.h1]
label = "H"
command = "claude"
adapter = "anthropic"
[harnesses.h1.env]
base_url = "ANTHROPIC_BASE_URL"
auth_token = "ANTHROPIC_AUTH_TOKEN"
api_key = "ANTHROPIC_API_KEY"
model = "ANTHROPIC_MODEL"
small_fast_model = "ANTHROPIC_SMALL_FAST_MODEL"
default_opus = "ANTHROPIC_DEFAULT_OPUS_MODEL"
default_sonnet = "ANTHROPIC_DEFAULT_SONNET_MODEL"
default_haiku = "ANTHROPIC_DEFAULT_HAIKU_MODEL"

[routes."h1.p1"]
""",
            "no default model",
        ),
        (
            """
[providers.p1]
label = "P"
default_model = "m"
models = ["m"]

[harnesses.h1]
label = "H"
command = "claude"
adapter = "telepathy"
""",
            "unknown adapter",
        ),
        (
            """
[providers.p1]
label = "P"
default_model = "not-listed"
models = ["m"]
""",
            "is not in models",
        ),
        (
            """
[providers.p1]
label = "P"
default_model = "m"
require_model = true
models = ["m"]
""",
            "contradicts",
        ),
        (
            """
[providers.p1]
label = "P"
default_model = "m"

[harnesses.h1]
label = "H"
command = "claude"
adapter = "anthropic"
[harnesses.h1.env]
base_url = "ANTHROPIC_BASE_URL"
auth_token = "ANTHROPIC_AUTH_TOKEN"
api_key = "ANTHROPIC_API_KEY"
model = "ANTHROPIC_MODEL"
small_fast_model = "ANTHROPIC_SMALL_FAST_MODEL"
default_opus = "ANTHROPIC_DEFAULT_OPUS_MODEL"
default_sonnet = "ANTHROPIC_DEFAULT_SONNET_MODEL"
default_haiku = "ANTHROPIC_DEFAULT_HAIKU_MODEL"

[routes."h1.p1"]
""",
            "needs provider",
        ),
        (
            """
[providers.p1]
label = "P"
default_model = "m"
models = ["m"]

[harnesses.h1]
label = "H"
command = "true"
adapter = "passthrough"

[routes."nope.p1"]
""",
            "unknown harness",
        ),
    ]
    for index, (content, needle) in enumerate(cases):
        config = fixture.tmp / f"invalid-{index}.toml"
        config.write_text(content)
        result = fixture.run(["check"], config=config)
        check(result.returncode == 2,
              f"invalid config {index} must fail, got {result.returncode}: {result.stdout}")
        check(needle in result.stderr,
              f"invalid config {index}: expected {needle!r}, got {result.stderr!r}")


TESTS = [
    test_config_valid,
    test_help,
    test_list,
    test_models,
    test_unknown_selection,
    test_unknown_model,
    test_minimax_default_model,
    test_require_model_fail_closed,
    test_shortcut_equivalence,
    test_shortcut_args_and_agent_model,
    test_shortcut_forbidden_args,
    test_shortcut_unknown_name,
    test_shortcuts_link_management,
    test_native_harness_not_wrapped,
    test_claude_deepseek_filters_preset_secrets,
    test_env_short_circuits_injection,
    test_missing_secret_fails,
    test_opencode_zen,
    test_opencode_deepseek,
    test_pi_deepseek,
    test_dsh_passthrough,
    test_forbidden_passthru_flags,
    test_model_precedence,
    test_fast_path_drops_declared_provider_creds,
    test_agent_model_env_warns,
    test_missing_harness,
    test_invalid_configs,
]


def main() -> int:
    failures = 0
    for test in TESTS:
        fixture = Fixture()
        try:
            test(fixture)
        except AssertionError as error:
            failures += 1
            print(f"not ok - {test.__name__}: {error}")
        except Exception as error:  # noqa: BLE001 - report and continue
            failures += 1
            print(f"not ok - {test.__name__}: unexpected {type(error).__name__}: {error}")
        else:
            print(f"ok - {test.__name__}")
        finally:
            fixture.clean()
    total = len(TESTS)
    if failures:
        print(f"FAILED: {failures}/{total} agent launcher tests")
        return 1
    print(f"all {total} agent launcher tests passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
