#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
config_file="$repo_root/.infisical.json"
probe_timeout_seconds="${DOTFILES_INFISICAL_PROBE_TIMEOUT_SECONDS:-20}"
# shellcheck source=../config/infisical.sh
source "$repo_root/config/infisical.sh"

run_with_timeout() {
  local seconds="$1"
  local stdout_file="$2"
  local stderr_file="$3"
  shift 3

  local pid
  local started
  local status

  "$@" >"$stdout_file" 2>"$stderr_file" &
  pid=$!
  started=$SECONDS

  while kill -0 "$pid" 2>/dev/null; do
    if (( SECONDS - started >= seconds )); then
      kill -TERM "$pid" 2>/dev/null || true
      sleep 0.2
      kill -KILL "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      return 124
    fi
    sleep 0.2
  done

  if wait "$pid"; then
    status=0
  else
    status=$?
  fi

  return "$status"
}

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing command infisical (install via pc-setup)\n' >&2
  exit 1
fi

printf 'ok      infisical %s\n' "$(infisical --version 2>/dev/null | head -n 1 || printf 'installed')"
printf 'ok      self-host site %s\n' "$INFISICAL_SITE_URL"

if [[ ! -f "$config_file" ]]; then
  printf 'missing tracked Infisical project binding: %s\n' "$config_file" >&2
  exit 1
fi

if ! grep -Eq "\"workspaceId\"[[:space:]]*:[[:space:]]*\"$INFISICAL_PROJECT_ID\"" "$config_file"; then
  printf 'failed  Infisical project binding does not match expected self-host project %s\n' "$INFISICAL_PROJECT_ID" >&2
  exit 1
fi

if ! grep -Eq "\"defaultEnvironment\"[[:space:]]*:[[:space:]]*\"$INFISICAL_ENVIRONMENT\"" "$config_file"; then
  printf 'failed  Infisical environment binding does not match expected environment %s\n' "$INFISICAL_ENVIRONMENT" >&2
  exit 1
fi

printf 'ok      project binding %s\n' "$INFISICAL_PROJECT_ID"
printf 'ok      environment %s\n' "$INFISICAL_ENVIRONMENT"

status_stdout="$(mktemp)"
status_stderr="$(mktemp)"
probe_stdout="$(mktemp)"
probe_stderr="$(mktemp)"
trap 'rm -f "$status_stdout" "$status_stderr" "$probe_stdout" "$probe_stderr"' EXIT

if run_with_timeout "$probe_timeout_seconds" "$status_stdout" "$status_stderr" infisical login status --json; then
  if ! grep -Fq "$INFISICAL_SITE_URL" "$status_stdout"; then
    printf 'failed  Infisical login is not bound to expected self-host site %s\n' "$INFISICAL_SITE_URL" >&2
    cat "$status_stdout" >&2
    exit 1
  fi
  printf 'ok      authenticated Infisical login session for self-host site\n'
else
  status=$?
  if [[ "$status" -eq 124 ]]; then
    printf 'failed  Infisical login status timed out after %ss\n' "$probe_timeout_seconds" >&2
  else
    printf 'failed  Infisical login session is missing or rejected\n' >&2
  fi
  cat "$status_stderr" >&2
  exit 1
fi

if run_with_timeout "$probe_timeout_seconds" "$probe_stdout" "$probe_stderr"   infisical run --projectId="$INFISICAL_PROJECT_ID" --env="$INFISICAL_ENVIRONMENT" --project-config-dir="$repo_root" -- true; then
  printf 'ok      authenticated self-hosted project access and runtime injection\n'
else
  status=$?
  if [[ "$status" -eq 124 ]]; then
    printf 'failed  Infisical project/runtime probe timed out after %ss\n' "$probe_timeout_seconds" >&2
    printf 'hint    on WSL verify the Infisical vault backend is file: infisical vault\n' >&2
  else
    printf 'failed  Infisical project/runtime probe exited with status %s\n' "$status" >&2
  fi
  cat "$probe_stderr" >&2
  exit 1
fi
