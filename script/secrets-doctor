#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
config_file="$repo_root/.infisical.json"

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing command infisical (install via pc-setup)\n' >&2
  exit 1
fi

printf 'ok      infisical %s\n' "$(infisical --version 2>/dev/null | head -n 1 || printf 'installed')"

if [[ ! -f "$config_file" ]]; then
  printf 'missing %s; run infisical init in %s\n' "$config_file" "$repo_root" >&2
  exit 1
fi

printf 'ok      project binding %s\n' "$config_file"

if infisical run --project-config-dir="$repo_root" -- true >/dev/null 2>&1; then
  printf 'ok      authenticated project access and runtime injection\n'
else
  printf 'failed  Infisical project access; run infisical login and verify project/environment permissions\n' >&2
  exit 1
fi
