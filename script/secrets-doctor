#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
config_file="$repo_root/.infisical.json"
# shellcheck source=../config/infisical.sh
source "$repo_root/config/infisical.sh"

if ! command -v infisical >/dev/null 2>&1; then
  printf 'missing command infisical (install via pc-setup)\n' >&2
  exit 1
fi

printf 'ok      infisical %s\n' "$(infisical --version 2>/dev/null | head -n 1 || printf 'installed')"
printf 'ok      self-host site %s\n' "$INFISICAL_SITE_URL"

if [[ ! -f "$config_file" ]]; then
  printf 'missing tracked Infisical project binding: %s\n' "$config_file" >&2
  exit 1
fi

if ! grep -Eq "\"workspaceId\"[[:space:]]*:[[:space:]]*\"$INFISICAL_PROJECT_ID\"" "$config_file"; then
  printf 'failed  Infisical project binding does not match expected self-host project %s\n' "$INFISICAL_PROJECT_ID" >&2
  exit 1
fi

if ! grep -Eq "\"defaultEnvironment\"[[:space:]]*:[[:space:]]*\"$INFISICAL_ENVIRONMENT\"" "$config_file"; then
  printf 'failed  Infisical environment binding does not match expected environment %s\n' "$INFISICAL_ENVIRONMENT" >&2
  exit 1
fi

printf 'ok      project binding %s\n' "$INFISICAL_PROJECT_ID"
printf 'ok      environment %s\n' "$INFISICAL_ENVIRONMENT"

if infisical run --projectId="$INFISICAL_PROJECT_ID" --env="$INFISICAL_ENVIRONMENT" --project-config-dir="$repo_root" -- true >/dev/null 2>&1; then
  printf 'ok      authenticated self-hosted project access and runtime injection\n'
else
  printf 'failed  Infisical self-host access; run: infisical login --domain=%s\n' "$INFISICAL_SITE_URL" >&2
  exit 1
fi
