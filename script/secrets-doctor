#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
key_file="${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}"
config_file="$repo_root/.sops.yaml"
status=0

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'ok      command %s\n' "$1"
  else
    printf 'missing command %s (install via pc-setup)\n' "$1" >&2
    status=1
  fi
}

check_command sops
check_command age-keygen

if [[ -f "$key_file" ]]; then
  printf 'ok      age identity %s\n' "$key_file"
  mode="$(stat -c '%a' "$key_file" 2>/dev/null || stat -f '%Lp' "$key_file" 2>/dev/null || true)"
  if [[ "$mode" != "600" ]]; then
    printf 'warning age identity mode is %s; expected 600\n' "${mode:-unknown}" >&2
    status=1
  fi
else
  printf 'missing age identity %s\n' "$key_file" >&2
  status=1
fi

if [[ -f "$config_file" ]]; then
  printf 'ok      SOPS config %s\n' "$config_file"
  if command -v age-keygen >/dev/null 2>&1 && [[ -f "$key_file" ]]; then
    recipient="$(age-keygen -y "$key_file")"
    if grep -Fq -- "$recipient" "$config_file"; then
      printf 'ok      configured recipient matches local identity\n'
    else
      printf 'drift   local age recipient is not present in .sops.yaml\n' >&2
      status=1
    fi
  fi
else
  printf 'missing %s; run ./script/secrets-init\n' "$config_file" >&2
  status=1
fi

if command -v sops >/dev/null 2>&1 && [[ -f "$key_file" ]]; then
  while IFS= read -r -d '' file; do
    if sops decrypt "$file" >/dev/null 2>&1; then
      printf 'ok      decrypt %s\n' "${file#"$repo_root"/}"
    else
      printf 'failed  decrypt %s\n' "${file#"$repo_root"/}" >&2
      status=1
    fi
  done < <(find "$repo_root/secrets" -type f \( -name '*.sops.json' -o -name '*.sops.yaml' \) -print0)
fi

exit "$status"
