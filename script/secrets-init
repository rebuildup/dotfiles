#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
key_file="${SOPS_AGE_KEY_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt}"
config_file="$repo_root/.sops.yaml"

for command in age-keygen sops; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'missing required command: %s (install it via pc-setup)\n' "$command" >&2
    exit 1
  fi
done

if [[ -f "$config_file" && ! -f "$key_file" ]]; then
  printf 'missing age private identity: %s\n' "$key_file" >&2
  printf '.sops.yaml already exists, so this is an existing secret domain.\n' >&2
  printf 'restore the existing root identity instead of generating a new one.\n' >&2
  exit 1
fi

mkdir -p "$(dirname "$key_file")"

if [[ ! -f "$key_file" ]]; then
  umask 077
  age-keygen -o "$key_file"
  printf 'generated initial age private identity at %s\n' "$key_file"
  printf 'back up this file outside the repository before relying on encrypted secrets\n'
fi

chmod 600 "$key_file"
recipient="$(age-keygen -y "$key_file")"

if [[ -e "$config_file" ]]; then
  if grep -Fq -- "$recipient" "$config_file"; then
    printf 'ok      %s contains the local age recipient\n' "$config_file"
  else
    printf 'conflict %s does not contain the recipient for %s\n' "$config_file" "$key_file" >&2
    printf 'local recipient: %s\n' "$recipient" >&2
    printf 'restore the correct root identity or perform an explicit key migration\n' >&2
    exit 1
  fi
else
  cat > "$config_file" <<EOF
creation_rules:
  - path_regex: ^secrets/.*\\.sops\\.(json|yaml)$
    age:
      - $recipient
EOF
  printf 'created %s with public recipient %s\n' "$config_file" "$recipient"
  printf 'review and commit .sops.yaml; never commit %s\n' "$key_file"
fi
