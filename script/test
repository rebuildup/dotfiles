#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

clean_home="$tmp/clean-home"
mkdir -p "$clean_home"

# Pin XDG_CONFIG_HOME alongside HOME so the Claude composer's overlay and state
# file land under the test home instead of leaking to the runner user's real
# ~/.config (CI Ubuntu defaults XDG_CONFIG_HOME to /home/runner/.config).
XDG_CONFIG_HOME="$clean_home/.config"
export XDG_CONFIG_HOME

HOME="$clean_home" "$repo_root/script/link"
HOME="$clean_home" bun "$repo_root/script/claude-settings.ts" compose
HOME="$clean_home" "$repo_root/script/check"
HOME="$clean_home" "$repo_root/script/link"
HOME="$clean_home" bun "$repo_root/script/claude-settings.ts" compose
HOME="$clean_home" "$repo_root/script/check"

expected_gitconfig="$repo_root/home/.gitconfig"
actual_gitconfig="$(readlink "$clean_home/.gitconfig")"
if [[ "$actual_gitconfig" != "$expected_gitconfig" ]]; then
  printf 'expected .gitconfig link to %s, got %s\n' "$expected_gitconfig" "$actual_gitconfig" >&2
  exit 1
fi

conflict_home="$tmp/conflict-home"
mkdir -p "$conflict_home"
printf 'keep-me\n' > "$conflict_home/.gitconfig"

if HOME="$conflict_home" "$repo_root/script/link"; then
  printf 'link unexpectedly succeeded with an unmanaged conflict\n' >&2
  exit 1
fi

if [[ "$(cat "$conflict_home/.gitconfig")" != 'keep-me' ]]; then
  printf 'link modified an unmanaged target\n' >&2
  exit 1
fi

if [[ -e "$conflict_home/.config/git/ignore" || -L "$conflict_home/.config/git/ignore" ]]; then
  printf 'link partially applied other managed targets before aborting\n' >&2
  exit 1
fi

# A top-level managed unit whose name contains a space must link as one unit,
# never split into word fragments by unit-name handling in link and check.
spaced_repo="$(cd "$tmp" && pwd -P)/spaced-repo"
mkdir -p "$spaced_repo/home"
cp -R "$repo_root/script" "$spaced_repo/script"
ln -s "$repo_root/home/.gitconfig" "$spaced_repo/home/my config"

spaced_home="$tmp/spaced-home"
mkdir -p "$spaced_home"
HOME="$spaced_home" "$spaced_repo/script/link"
HOME="$spaced_home" "$spaced_repo/script/check"

if [[ "$(readlink "$spaced_home/my config")" != "$spaced_repo/home/my config" ]]; then
  printf 'spaced unit was not linked as one entry\n' >&2
  exit 1
fi

if [[ -e "$spaced_home/my" || -L "$spaced_home/my" || -e "$spaced_home/config" || -L "$spaced_home/config" ]]; then
  printf 'spaced unit was split into word fragments\n' >&2
  exit 1
fi

# Composer-owned Claude backups left in the working tree (an untracked
# home/.claude/settings.json.bak from a migration, or the older
# pre-dotfiles-* pattern) must not be promoted to managed symlinks by
# script/link and must not be reported as missing or drift by script/check.
# The composer writes its real backups under the state directory, but
# defensively skipping these patterns in link/check means a leftover file
# inside the repo cannot leak into HOME and cannot be flagged as drift.
backup_repo="$(cd "$tmp" && pwd -P)/backup-repo"
mkdir -p "$backup_repo/home/.claude"
cp -R "$repo_root/script" "$backup_repo/script"
cp "$repo_root/home/.claude/statusline-command.sh" "$backup_repo/home/.claude/statusline-command.sh"
cat > "$backup_repo/home/.claude/settings.json.bak" <<'EOF'
{ "leftover": "from-migration" }
EOF
cat > "$backup_repo/home/.claude/settings.json.pre-dotfiles-20250101" <<'EOF'
{ "leftover": "pre-dotfiles-pattern" }
EOF

backup_home="$tmp/backup-home"
mkdir -p "$backup_home"
XDG_CONFIG_HOME="$backup_home/.config" HOME="$backup_home" "$backup_repo/script/link"
XDG_CONFIG_HOME="$backup_home/.config" HOME="$backup_home" "$backup_repo/script/check"

if [[ -L "$backup_home/.claude/settings.json.bak" || -e "$backup_home/.claude/settings.json.bak" ]]; then
  printf 'link/check promoted a leftover composer-owned .bak file to a managed target\n' >&2
  exit 1
fi
if [[ -L "$backup_home/.claude/settings.json.pre-dotfiles-20250101" || -e "$backup_home/.claude/settings.json.pre-dotfiles-20250101" ]]; then
  printf 'link/check promoted a leftover composer-owned pre-dotfiles-* file to a managed target\n' >&2
  exit 1
fi
if HOME="$backup_home" "$backup_repo/script/link" 2>&1 | grep -q "settings.json.bak\|pre-dotfiles"; then
  printf 'link reported a composer-owned backup file as drift\n' >&2
  exit 1
fi
if XDG_CONFIG_HOME="$backup_home/.config" HOME="$backup_home" "$backup_repo/script/check" 2>&1 | grep -q "settings.json.bak\|pre-dotfiles"; then
  printf 'check reported a composer-owned backup file as drift\n' >&2
  exit 1
fi

printf 'symlink behavior tests passed\n'
