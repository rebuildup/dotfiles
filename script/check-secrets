#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"
status=0

if git grep -n -I -E 'AGE-SECRET-KEY-|-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----' --   ':!docs/adr/ADR-0003.md'   ':!docs/adr/ADR-0004.md'   ':!script/check-secrets'; then
  printf 'tracked private key material detected\n' >&2
  status=1
fi

while IFS= read -r path; do
  case "$path" in
    .sops.yaml|*.sops.json|*.sops.yaml)
      printf 'legacy SOPS payload/config must not be active Git state: %s\n' "$path" >&2
      status=1
      ;;
    *.env.example|*.example.env|.env.example|*/.env.example|.env.*.example|*/.env.*.example)
      ;;
    .env|*/.env|.env.*|*/.env.*|*.env)
      printf 'plaintext environment file must not be tracked: %s\n' "$path" >&2
      status=1
      ;;
    home/.config/infisical/*|home/.infisical/*|home/infisical-keyring/*|home/.ssh/id_*|home/.ssh/*.pem|home/.ssh/*.key)
      printf 'machine-local credential material must not be managed through home/: %s\n' "$path" >&2
      status=1
      ;;
    secrets/*)
      printf 'secret payloads must live in Infisical, not repository secrets/: %s\n' "$path" >&2
      status=1
      ;;
  esac
done < <(git ls-files)

exit "$status"
