#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"
status=0

if git grep -n -I -E 'AGE-SECRET-KEY-|-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----' --   ':!docs/adr/ADR-0003.md'   ':!secrets/README.md'   ':!script/check-secrets'; then
  printf 'tracked private key material detected\n' >&2
  status=1
fi

while IFS= read -r path; do
  case "$path" in
    home/.config/sops/age/*|home/.ssh/id_*|home/.ssh/*.pem|home/.ssh/*.key)
      printf 'private material must not be managed through home/: %s\n' "$path" >&2
      status=1
      ;;
  esac
done < <(git ls-files)

exit "$status"
