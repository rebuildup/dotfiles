#!/usr/bin/env bash
set -euo pipefail

source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# Canonicalize: scripts resolve paths with `pwd -P`, so comparisons against
# $tmp must use the same form (macOS maps /var to /private/var).
tmp="$(cd "$(mktemp -d)" && pwd -P)"
trap 'rm -rf "$tmp"' EXIT

repo="$tmp/repo"
home="$tmp/home"
fake_bin="$tmp/bin"
gh_log="$tmp/gh.log"
gh_state="$tmp/gh-authenticated"
infisical_log="$tmp/infisical.log"
infisical_state="$tmp/infisical-authenticated"
infisical_vault_state="$tmp/infisical-vault"
mkdir -p "$repo" "$home" "$fake_bin"

# script/link and script/check resolve their own roots with `pwd -P`. On
# platforms where TMPDIR is itself a symlink (macOS /var -> private/var) the
# recorded link targets use the physical path, so assertions must compare
# against physical paths too.
repo="$(cd "$repo" && pwd -P)"
home="$(cd "$home" && pwd -P)"
fake_bin="$(cd "$fake_bin" && pwd -P)"

git -C "$source_root" archive HEAD | tar -x -C "$repo"
git -C "$repo" init -q -b main
git -C "$repo" config user.name 'Test Committer'
git -C "$repo" config user.email 'committer@example.invalid'
git -C "$repo" add .
git -C "$repo" commit -qm 'test fixture'

cat >> "$repo/home/.gitconfig" <<'EOF'

[user]
	name = Migrated User
	email = migrated@example.invalid
EOF

git -C "$repo" add home/.gitconfig
git -C "$repo" commit -qm 'fixture: misplaced managed identity'

# Materialize a shared Claude baseline inside the test repo. `git archive` does
# not recurse into submodules, so `agents/claude/` arrives as an empty tree;
# without this fixture, bootstrap fails the "shared Claude baseline missing"
# pre-flight and the regression for the compose-before-check ordering cannot be
# exercised.
mkdir -p "$repo/agents/claude"
cat > "$repo/agents/claude/settings.json" <<'EOF'
{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash(git status)"]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "shared-start" }] }
    ]
  }
}
EOF
git -C "$repo" add agents/claude/settings.json
git -C "$repo" commit -qm 'fixture: shared Claude baseline'

cat > "$fake_bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$FAKE_GH_LOG"

case "$*" in
  "auth status --hostname github.com")
    [[ -f "$FAKE_GH_STATE" ]] || exit 1
    ;;
  "auth login --hostname github.com --git-protocol https --web")
    : > "$FAKE_GH_STATE"
    git config --global --replace-all credential.https://github.com.helper ''
    git config --global --add credential.https://github.com.helper '!gh auth git-credential'
    ;;
  "auth setup-git --hostname github.com")
    git config --global --replace-all credential.https://github.com.helper ''
    git config --global --add credential.https://github.com.helper '!gh auth git-credential'
    ;;
esac
EOF

cat > "$fake_bin/infisical" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf '%s|%s\n' "${INFISICAL_API_URL:-unset}" "$*" >> "$FAKE_INFISICAL_LOG"

case "${1:-}" in
  --version)
    printf '%s\n' 'infisical version test'
    ;;
  vault)
    if [[ "${2:-}" == "set" && "${3:-}" == "file" ]]; then
      previous="$(cat "$FAKE_INFISICAL_VAULT_STATE" 2>/dev/null || printf 'auto')"
      printf '%s\n' 'file' > "$FAKE_INFISICAL_VAULT_STATE"
      if [[ "$previous" != 'file' ]]; then
        rm -f "$FAKE_INFISICAL_STATE"
      fi
    else
      current="$(cat "$FAKE_INFISICAL_VAULT_STATE" 2>/dev/null || printf 'auto')"
      printf 'You are currently using [%s] vault to store your login credentials\n' "$current" >&2
    fi
    ;;
  login)
    if [[ "${2:-}" == "status" ]]; then
      if [[ ! -f "$FAKE_INFISICAL_STATE" ]]; then
        printf '%s\n' 'not authenticated' >&2
        exit 1
      fi
      printf '{"sessions":[{"principalType":"user","status":"authenticated","domain":"https://secrets.rebuildup.dev"}]}\n'
    else
      : > "$FAKE_INFISICAL_STATE"
    fi
    ;;
  run)
    if [[ ! -f "$FAKE_INFISICAL_STATE" ]]; then
      exit 1
    fi
    if [[ "${FAKE_INFISICAL_HANG_RUN:-0}" == "1" ]]; then
      while :; do :; done
    fi
    ;;
  *)
    ;;
esac
EOF

chmod +x "$fake_bin/gh" "$fake_bin/infisical"

mkdir -p "$home/.config/git"
cat > "$home/.gitconfig" <<EOF
[alias]
	co = checkout
[core]
	excludesFile = $home/.config/git/ignore
EOF

cat > "$home/.config/git/ignore" <<'EOF'
.DS_Store
*.local-only
EOF

# Pre-populate an unmanaged live ~/.claude/settings.json so the regression
# covers the existing-HOME first-run path: an unmanaged file with a Herdr hook
# and a machine-local overlay must be imported (not lost) when compose runs
# before script/check.
mkdir -p "$home/.claude"
cat > "$home/.claude/settings.json" <<'EOF'
{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": ["Bash(git status)"]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "shared-start" }] },
      { "hooks": [{ "type": "command", "command": "herdr-session-start" }] }
    ]
  },
  "localOnly": { "theme": "dark" }
}
EOF

# Pin XDG_CONFIG_HOME alongside HOME so the Claude composer's overlay and
# state file land under the test home instead of leaking to the runner user's
# real ~/.config (CI Ubuntu defaults XDG_CONFIG_HOME to /home/runner/.config).
# Exported once for both bootstrap runs and the post-rerun check.
export XDG_CONFIG_HOME="$home/.config"

HOME="$home" PATH="$fake_bin:$PATH" FAKE_GH_LOG="$gh_log" FAKE_GH_STATE="$gh_state" FAKE_INFISICAL_LOG="$infisical_log" FAKE_INFISICAL_STATE="$infisical_state" FAKE_INFISICAL_VAULT_STATE="$infisical_vault_state" WSL_DISTRO_NAME=Ubuntu DOTFILES_GIT_NAME='Fallback User' DOTFILES_GIT_EMAIL='fallback@example.invalid' DOTFILES_ALLOW_INTERACTIVE_AUTH=1 DOTFILES_SKIP_AGENT_SUBMODULES=1 "$repo/script/bootstrap"

if [[ ! -L "$home/.gitconfig" || "$(readlink "$home/.gitconfig")" != "$repo/home/.gitconfig" ]]; then
  printf 'bootstrap did not adopt ~/.gitconfig as the managed symlink\n' >&2
  exit 1
fi

if [[ ! -f "$home/.gitconfig.pre-dotfiles" ]]; then
  printf 'bootstrap did not preserve the original ~/.gitconfig backup\n' >&2
  exit 1
fi

if [[ "$(git config --file "$home/.gitconfig.local" --get alias.co)" != 'checkout' ]]; then
  printf 'bootstrap did not preserve user-owned Git config in the local config\n' >&2
  exit 1
fi

if [[ ! -L "$home/.config/git/ignore" || "$(readlink "$home/.config/git/ignore")" != "$repo/home/.config/git/ignore" ]]; then
  printf 'bootstrap did not adopt the global ignore as the managed symlink\n' >&2
  exit 1
fi

if [[ ! -f "$home/.config/git/ignore.pre-dotfiles" ]]; then
  printf 'bootstrap did not preserve the original global ignore backup\n' >&2
  exit 1
fi

if [[ "$(git config --file "$home/.gitconfig.local" --get core.excludesFile)" != "$home/.config/git/ignore.local" ]]; then
  printf 'bootstrap did not activate the merged local global-ignore override\n' >&2
  exit 1
fi

for pattern in '.DS_Store' 'Thumbs.db' '*.local-only'; do
  if ! grep -Fxq "$pattern" "$home/.config/git/ignore.local"; then
    printf 'bootstrap lost global ignore pattern: %s\n' "$pattern" >&2
    exit 1
  fi
done

if [[ "$(git config --file "$home/.gitconfig.local" --get user.name)" != 'Migrated User' ]]; then
  printf 'bootstrap did not migrate Git user.name to local config\n' >&2
  exit 1
fi

if [[ "$(git config --file "$home/.gitconfig.local" --get user.email)" != 'migrated@example.invalid' ]]; then
  printf 'bootstrap did not migrate Git user.email to local config\n' >&2
  exit 1
fi

if git config --file "$repo/home/.gitconfig" --get user.name >/dev/null 2>&1 ||
   git config --file "$repo/home/.gitconfig" --get user.email >/dev/null 2>&1; then
  printf 'bootstrap left identity in managed .gitconfig\n' >&2
  exit 1
fi

if ! grep -Fq 'auth login --hostname github.com --git-protocol https --web' "$gh_log"; then
  printf 'bootstrap did not exercise first-time GitHub authentication\n' >&2
  exit 1
fi

if ! grep -Fq 'auth setup-git --hostname github.com' "$gh_log"; then
  printf 'bootstrap did not configure gh as the Git credential helper\n' >&2
  exit 1
fi

if [[ "$(git config --file "$home/.gitconfig.local" --get credential.https://github.com.helper)" != '!gh auth git-credential' ]]; then
  printf 'bootstrap did not keep the GitHub credential helper in local Git config\n' >&2
  exit 1
fi

if git config --file "$repo/home/.gitconfig" --get credential.https://github.com.helper >/dev/null 2>&1; then
  printf 'bootstrap leaked the GitHub credential helper into managed .gitconfig\n' >&2
  exit 1
fi

# Claude composition ran before script/check: the live file must now be a
# regular file (not a symlink), the Herdr hook and machine-local overlay must
# survive, the shared statusLine must be present, a legacy backup of the
# unmanaged live file must exist under the state directory (outside the
# managed dotfiles repository), and the imported overlay must carry the
# Herdr hook. With the old check-before-compose ordering, script/check would
# have aborted bootstrap with drift on ~/.claude/settings.json before any of
# these could be true.
if [[ -L "$home/.claude/settings.json" ]]; then
  printf 'compose left ~/.claude/settings.json as a symlink instead of a regular file\n' >&2
  exit 1
fi
if [[ ! -f "$home/.claude/settings.json" ]]; then
  printf 'compose did not write ~/.claude/settings.json\n' >&2
  exit 1
fi

composed_claude="$(cat "$home/.claude/settings.json")"
case "$composed_claude" in
  *herdr-session-start*) ;;
  *) printf 'compose dropped the Herdr SessionStart hook from the live file\n' >&2; exit 1 ;;
esac
case "$composed_claude" in
  *'bash ~/.claude/statusline-command.sh'*) ;;
  *) printf 'compose dropped the shared statusLine from the live file\n' >&2; exit 1 ;;
esac
case "$composed_claude" in
  *'"localOnly":'*) ;;
  *) printf 'compose dropped the machine-local overlay from the live file\n' >&2; exit 1 ;;
esac

overlay_file="$home/.config/dotfiles/claude/settings.local.json"
if [[ ! -f "$overlay_file" ]]; then
  printf 'compose did not create the machine-local overlay at %s\n' "$overlay_file" >&2
  exit 1
fi
if ! grep -Fq 'herdr-session-start' "$overlay_file"; then
  printf 'compose did not import the Herdr SessionStart hook into the overlay\n' >&2
  exit 1
fi
overlay_before="$(cat "$overlay_file")"

claude_backups="$(find "$home/.config/dotfiles/claude" -maxdepth 1 -type d -name 'legacy-*' | wc -l | tr -d ' ')"
if [[ "$claude_backups" -ne 1 ]]; then
  printf 'compose did not create a single legacy backup of the unmanaged live settings (got %s)\n' "$claude_backups" >&2
  exit 1
fi
legacy_backup_dir="$(find "$home/.config/dotfiles/claude" -maxdepth 1 -type d -name 'legacy-*' -print -quit)"
legacy_backup="$legacy_backup_dir/settings.json"
if [[ ! -f "$legacy_backup" ]]; then
  printf 'legacy backup dir %s has no settings.json inside it\n' "$legacy_backup_dir" >&2
  exit 1
fi
if ! grep -q 'herdr-session-start' "$legacy_backup"; then
  printf 'legacy backup of the unmanaged live settings did not preserve the Herdr hook\n' >&2
  exit 1
fi
if ! grep -q 'localOnly' "$legacy_backup"; then
  printf 'legacy backup of the unmanaged live settings did not preserve the machine-local overlay\n' >&2
  exit 1
fi

HOME="$home" PATH="$fake_bin:$PATH" FAKE_GH_LOG="$gh_log" FAKE_GH_STATE="$gh_state" FAKE_INFISICAL_LOG="$infisical_log" FAKE_INFISICAL_STATE="$infisical_state" FAKE_INFISICAL_VAULT_STATE="$infisical_vault_state" WSL_DISTRO_NAME=Ubuntu DOTFILES_ALLOW_INTERACTIVE_AUTH=1 DOTFILES_SKIP_AGENT_SUBMODULES=1 "$repo/script/bootstrap"

if [[ "$(find "$home" -maxdepth 1 -name '.gitconfig.pre-dotfiles*' -type f | wc -l)" -ne 1 ]]; then
  printf 'bootstrap created duplicate ~/.gitconfig migration backups on rerun\n' >&2
  exit 1
fi

if [[ "$(find "$home/.config/git" -maxdepth 1 -name 'ignore.pre-dotfiles*' -type f | wc -l)" -ne 1 ]]; then
  printf 'bootstrap created duplicate global-ignore migration backups on rerun\n' >&2
  exit 1
fi

# Rerun composition must be idempotent: no new legacy backup, no change
# to the live file, the overlay still carries the imported hook, and a
# subsequent claude-settings check reports ok rather than drift.
claude_backups_after="$(find "$home/.config/dotfiles/claude" -maxdepth 1 -type d -name 'legacy-*' | wc -l)"
if [[ "$claude_backups_after" -ne 1 ]]; then
  printf 'bootstrap created duplicate settings.json legacy backups on rerun (got %s)\n' "$claude_backups_after" >&2
  exit 1
fi

composed_claude_after="$(cat "$home/.claude/settings.json")"
if [[ "$composed_claude_after" != "$composed_claude" ]]; then
  printf 'compose rewrote ~/.claude/settings.json on rerun (was not idempotent)\n' >&2
  exit 1
fi

overlay_after="$(cat "$overlay_file")"
if [[ "$overlay_after" != "$overlay_before" ]]; then
  printf 'compose rewrote the machine-local overlay on rerun (was not idempotent)\n' >&2
  exit 1
fi
if ! grep -Fq 'herdr-session-start' "$overlay_file"; then
  printf 'rerun lost the Herdr SessionStart hook from the overlay\n' >&2
  exit 1
fi

HOME="$home" bun "$repo/script/claude-settings.ts" check >/dev/null

expected_site='https://secrets.rebuildup.dev'
expected_api='https://secrets.rebuildup.dev/api'
expected_project='d4c2fc09-a923-4a38-9cf4-b51769aadb76'
expected_environment='dev'

if ! grep -Fxq "$expected_api|vault set file" "$infisical_log"; then
  printf 'bootstrap did not switch WSL to the Infisical file vault\n' >&2
  exit 1
fi

if ! grep -Fxq "$expected_api|login --domain=$expected_site" "$infisical_log"; then
  printf 'bootstrap did not login to the pinned self-hosted Infisical domain\n' >&2
  exit 1
fi

if grep -Fq '|init' "$infisical_log"; then
  printf 'bootstrap unexpectedly re-initialized the tracked Infisical project binding\n' >&2
  exit 1
fi

if ! grep -Eq "\"workspaceId\"[[:space:]]*:[[:space:]]*\"$expected_project\"" "$repo/.infisical.json"; then
  printf 'tracked Infisical project binding does not match the self-hosted project\n' >&2
  exit 1
fi

if ! grep -Fq "$expected_api|run --projectId=$expected_project --env=$expected_environment --project-config-dir=" "$infisical_log"; then
  printf 'bootstrap did not validate the explicit self-hosted Infisical project/environment\n' >&2
  exit 1
fi

HOME="$home" PATH="$fake_bin:$PATH" FAKE_INFISICAL_LOG="$infisical_log" FAKE_INFISICAL_STATE="$infisical_state" FAKE_INFISICAL_VAULT_STATE="$infisical_vault_state" WSL_DISTRO_NAME=Ubuntu DOTFILES_INFISICAL_ENV=ignored DOTFILES_INFISICAL_PATH=/ignored "$repo/script/with-secrets" true

last_infisical_call="$(tail -n 1 "$infisical_log")"

if [[ "$last_infisical_call" != "$expected_api|run --projectId=$expected_project --env=$expected_environment --project-config-dir="*' -- true' ]]; then
  printf 'with-secrets did not delegate to the explicit self-hosted project/environment: %s\n' "$last_infisical_call" >&2
  exit 1
fi

if [[ "$last_infisical_call" == *'--path='* ]]; then
  printf 'with-secrets unexpectedly narrowed secrets by path\n' >&2
  exit 1
fi

if HOME="$home" PATH="$fake_bin:$PATH" FAKE_INFISICAL_LOG="$infisical_log" FAKE_INFISICAL_STATE="$infisical_state" FAKE_INFISICAL_VAULT_STATE="$infisical_vault_state" FAKE_INFISICAL_HANG_RUN=1 DOTFILES_INFISICAL_PROBE_TIMEOUT_SECONDS=1 "$repo/script/secrets-doctor"; then
  printf 'secrets-doctor unexpectedly accepted a hung Infisical runtime probe\n' >&2
  exit 1
fi

# Old-layout migration: a pre-0.3.0 install left a symlink from
# ~/.claude/settings.json to <repo>/home/.claude/settings.json. The
# composer must unlink the dangling symlink and write a fresh composed
# file rather than aborting with drift.
old_layout_home="$tmp/old-layout-home"
mkdir -p "$old_layout_home/.claude"
ln -s "$repo/home/.claude/settings.json" "$old_layout_home/.claude/settings.json"
XDG_CONFIG_HOME="$old_layout_home/.config" HOME="$old_layout_home" bun "$repo/script/claude-settings.ts" compose >/dev/null

if [[ -L "$old_layout_home/.claude/settings.json" ]]; then
  printf 'composer left the old-layout symlink in place after migration\n' >&2
  exit 1
fi
if [[ ! -f "$old_layout_home/.claude/settings.json" ]]; then
  printf 'composer did not write a fresh settings.json after old-layout migration\n' >&2
  exit 1
fi
if ! grep -Fq 'bypassPermissions' "$old_layout_home/.claude/settings.json"; then
  printf 'old-layout migration dropped the shared baseline\n' >&2
  exit 1
fi
old_layout_backups="$(find "$old_layout_home/.config/dotfiles/claude" -maxdepth 1 -type d -name 'legacy-*' 2>/dev/null | wc -l)"
if [[ "$old_layout_backups" -ne 0 ]]; then
  printf 'old-layout migration should not create a backup for a dangling symlink (got %s)\n' "$old_layout_backups" >&2
  exit 1
fi
# Nothing must be left next to the live file in the old-layout home: backups
# always live under the state directory, never beside ~/.claude/settings.json.
if [[ -n "$(find "$old_layout_home/.claude" -maxdepth 1 \( -name 'settings.json.bak' -o -name 'settings.json.pre-dotfiles-*' \) -type f 2>/dev/null)" ]]; then
  printf 'old-layout migration left a backup next to the live file in %s\n' "$old_layout_home/.claude" >&2
  exit 1
fi

# Old-layout migration with an existing target: the user has been editing
# the old-layout file through the symlink. The composer must back the
# target file aside before unlinking so the user's customizations survive.
existing_layout_home="$tmp/existing-layout-home"
mkdir -p "$existing_layout_home/.claude" "$repo/home/.claude"
cat > "$repo/home/.claude/settings.json" <<'EOF'
{ "userCustomized": "preserved-by-composer" }
EOF
ln -s "$repo/home/.claude/settings.json" "$existing_layout_home/.claude/settings.json"
XDG_CONFIG_HOME="$existing_layout_home/.config" HOME="$existing_layout_home" bun "$repo/script/claude-settings.ts" compose >/dev/null

if [[ -L "$existing_layout_home/.claude/settings.json" ]]; then
  printf 'composer left the old-layout symlink in place when the target still exists\n' >&2
  exit 1
fi
existing_legacy_dir="$existing_layout_home/.config/dotfiles/claude"
existing_backups="$(find "$existing_legacy_dir" -maxdepth 1 -type d -name 'legacy-*' 2>/dev/null)"
if [[ -z "$existing_backups" ]]; then
  printf 'composer did not back up the existing old-layout target file under %s\n' "$existing_legacy_dir" >&2
  exit 1
fi
legacy_backup_file="$existing_backups/settings.json"
# find returns paths newline-separated; the first one is the only entry.
legacy_backup_file="${existing_backups%%$'\n'*}/settings.json"
if [[ ! -f "$legacy_backup_file" ]]; then
  printf 'composer wrote a legacy dir but not a settings.json inside it\n' >&2
  exit 1
fi
if ! grep -Fq 'preserved-by-composer' "$legacy_backup_file"; then
  printf 'backup did not preserve the user-customized old-layout content\n' >&2
  exit 1
fi
# The backup must live outside the managed dotfiles repository. Anything
# left next to the old-layout target inside the repo would risk being
# re-linked by script/link or accidentally committed.
if [[ -n "$(find "$repo/home/.claude" -maxdepth 1 \( -name 'settings.json.bak' -o -name 'settings.json.pre-dotfiles-*' \) -type f 2>/dev/null)" ]]; then
  printf 'composer left a backup inside the managed dotfiles repo at %s\n' "$repo/home/.claude" >&2
  exit 1
fi
# Clean up the fixture so the test repo is reusable.
rm -f "$repo/home/.claude/settings.json"
rm -rf "$existing_legacy_dir"/legacy-*

printf 'legacy\n' > "$repo/.sops.yaml"
git -C "$repo" add -f .sops.yaml

if "$repo/script/check-secrets"; then
  printf 'check-secrets unexpectedly accepted legacy SOPS state\n' >&2
  exit 1
fi

git -C "$repo" reset -q HEAD -- .sops.yaml
rm -f "$repo/.sops.yaml"

printf 'bootstrap and Infisical workflow tests passed\n'
